{
  "name": "client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "validate-i18n": "node -e \"require('fs').readdirSync('public/i18n').forEach(f=>{try{JSON.parse(require('fs').readFileSync('public/i18n/'+f,'utf8'));console.log(f+': OK')}catch(e){console.error(f+': '+e.message);process.exit(1)}})\"",
    "build": "npm run validate-i18n && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "generate": "openapi-generator-cli generate && node -e \"const fs=require('fs'),path=require('path');function visit(d){for(const f of fs.readdirSync(d,{withFileTypes:true})){const p=path.join(d,f.name);if(f.isDirectory())visit(p);else if(f.name.endsWith('.ts')){const c=fs.readFileSync(p,'utf8');if(!c.startsWith('// @ts-nocheck'))fs.writeFileSync(p,'// @ts-nocheck\\n'+c);}}}visit('src/generated')\"",
    "e2e": "playwright test",
    "lint": "ng lint --max-warnings=0",
    "lint:openapi": "redocly lint ../qwixx_openapi.yml --config ../.redocly.yaml",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "prepare": "[ -n \"$CI\" ] || (cd .. && git config core.hooksPath client/.husky)"
  },
  "private": true,
  "packageManager": "npm@12.0.1",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "html2canvas": "^1.4.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "overrides": {
    "shell-quote": "1.10.0",
    "esbuild": "0.28.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "^2.23.0",
    "@playwright/test": "^1.59.1",
    "@redocly/cli": "^2.39.0",
    "@vitest/coverage-v8": "^4.1.5",
    "angular-eslint": "22.1.0",
    "eslint": "^10.3.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "8.65.0",
    "vitest": "^4.0.8"
  }
}
