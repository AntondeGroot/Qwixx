<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
  <property name="severity" value="error"/>

  <module name="TreeWalker">

    <!-- Allow // NOCHECKSTYLE <RuleName> inline suppressions on the same line -->
    <module name="SuppressWithNearbyCommentFilter">
      <property name="commentFormat" value="NOCHECKSTYLE (\w+)"/>
      <property name="checkFormat" value="$1"/>
      <property name="influenceFormat" value="0"/>
    </module>

    <!-- Naming conventions -->
    <module name="TypeName"/>
    <!-- Allow log/logger as names for SLF4J static-final logger fields -->
    <module name="ConstantName">
      <property name="format" value="^(log|logger|[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)$"/>
    </module>
    <module name="LocalVariableName"/>
    <module name="MemberName"/>
    <!-- Allow underscore_separated names in test methods (given_when_then convention) -->
    <module name="MethodName">
      <property name="format" value="^[a-z][a-zA-Z0-9_]*$"/>
    </module>
    <module name="PackageName"/>
    <module name="ParameterName"/>
    <module name="StaticVariableName"/>

    <!-- Imports -->
    <module name="AvoidStarImport"/>
    <module name="RedundantImport"/>
    <module name="UnusedImports"/>

    <!-- Code quality -->
    <module name="EqualsHashCode"/>
    <module name="StringLiteralEquality"/>
    <module name="NoFinalizer"/>
    <module name="ModifiedControlVariable"/>
    <module name="NestedTryDepth">
      <property name="max" value="2"/>
    </module>

  </module>
</module>
